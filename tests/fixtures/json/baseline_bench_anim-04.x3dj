{ "X3D":
  {
    "encoding": "UTF-8",
    "@profile": "Immersive",
    "@version": "4.1",
    "@xsd:noNamespaceSchemaLocation": "https://www.web3d.org/specifications/x3d-4.1.xsd",
    "JSON schema": "https://www.web3d.org/specifications/x3d-4.1-JSONSchema.json",
    "head": {
      "meta": [
        {
          "@name": "title",
          "@content": "ColorCyclingSphere.x3d"
        },
        {
          "@name": "description",
          "@content": "A sphere whose colour cycles red, green, blue over 6 seconds using a ColorInterpolator."
        },
        {
          "@name": "generator",
          "@content": "x3d-tidy V3.1.1, https://www.npmjs.com/package/x3d-tidy"
        },
        {
          "@name": "modified",
          "@content": "Sat, 17 Oct 2026 20:54:39 GMT"
        }
      ]
    },
    "Scene": {
      "-children": [
        { "WorldInfo":
          {
            "@title": "Color Cycling Sphere"
          }
        },
        { "Viewpoint":
          {
            "@description": "View Sphere",
            "@position": [ 0, 0, 5 ]
          }
        },
        { "TimeSensor":
          {
            "@DEF": "ColorTimer",
            "@cycleInterval": 6,
            "@loop": true
          }
        },
        { "ColorInterpolator":
          {
            "@DEF": "SphereColorInterp",
            "@key": [
              0,
              0.3333,
              0.6667,
              1
            ],
            "@keyValue": [
              1, 0, 0,
              0, 1, 0,
              0, 0, 1,
              1, 0, 0
            ]
          }
        },
        { "Shape":
          {
            "-appearance": { "Appearance":
              {
                "-material": { "Material":
                  {
                    "@DEF": "SphereMaterial",
                    "@diffuseColor": [ 0, 0.6490702, 1 ]
                  }
                }
              }
            },
            "-geometry": { "Sphere":
              {
                "@radius": 1.5
              }
            }
          }
        },
        { "ROUTE":
          {
            "@fromNode": "ColorTimer",
            "@fromField": "fraction_changed",
            "@toNode": "SphereColorInterp",
            "@toField": "set_fraction"
          }
        },
        { "ROUTE":
          {
            "@fromNode": "SphereColorInterp",
            "@fromField": "value_changed",
            "@toNode": "SphereMaterial",
            "@toField": "set_diffuseColor"
          }
        }
      ]
    }
  }
}
