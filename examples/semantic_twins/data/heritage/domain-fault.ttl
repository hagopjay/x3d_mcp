h:tierDocumented a crm:E55_Type ; rdfs:label "documented" .
h:tierTheorized a crm:E55_Type ; rdfs:label "theorized" .
h:tierSpeculative a crm:E55_Type ; rdfs:label "speculative" .
h:Giza a crm:E27_Site ; rdfs:label "Giza plateau" ; crm:P46_is_composed_of h:OsirisShaft, h:Sphinx, h:GreatPyramid, h:HallOfRecords, h:OneSystem .
h:OsirisShaft a crm:E25_Human-Made_Feature ; rdfs:label "Osiris Shaft" ; crm:P46_is_composed_of h:Level1, h:Level2, h:Level3 .
h:Level1 a crm:E25_Human-Made_Feature ; rdfs:label "Osiris Shaft, Level 1" ; crm:P46_is_composed_of h:OsirisShaftA, h:OsirisChamberA .
h:Level2 a crm:E25_Human-Made_Feature ; rdfs:label "Osiris Shaft, Level 2" ; crm:P46_is_composed_of h:OsirisShaftB, h:OsirisChamberB .
h:Level3 a crm:E25_Human-Made_Feature ; rdfs:label "Osiris Shaft, Level 3" ; crm:P46_is_composed_of h:OsirisShaftC, h:OsirisLevel3 .
h:GreatPyramid a crm:E22_Human-Made_Object ; rdfs:label "Great Pyramid of Khufu" ; crm:P46_is_composed_of h:KingsChamber, h:BigVoid .
h:Sphinx crm:P46_is_composed_of h:PawVoid .
