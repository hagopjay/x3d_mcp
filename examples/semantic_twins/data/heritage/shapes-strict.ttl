# Heritage twin, strict shapes. Hand-written; shapes.ttl beside it is generated by build/domain.py and is unchanged.
#
# Why: shapes.ttl catches the two planted faults of this case, but a review (20 Nov 2026) planted eight more and
# all eight passed (data/heritage/mutants.json). Its measurement shape only fires when the scene has exactly
# Transform > Shape > Box with a written size, so anything it cannot measure reads as "conforms". These shapes
# state the rule in the messages and treat "cannot measure" as a result of its own.
#
#   S_H1s  every drawn element has an attribution whose assigned value is a tier (a crm:E55_Type)
#   S_H3   every visual item named by the record is a node of this scene
#   S_H4   every Shape in the scene sits under a node the record vouches for
#   S_H5   a measurement that is compared with the scene is in metres
#   S_H6   a measurement can be checked: one Box below its representation, nothing rotated or scaled on the way
#   S_H2s  the drawn size (Box size, default 2, times the representing Transform's scale) is within 5 %
#
# Limits, stated: only Box geometry is measured (anything else is S_H6, never a silent pass); the tolerance is
# relative to the documented value; a wrong but well-formed record cannot be seen from here.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix x3do: <https://www.web3d.org/specifications/X3dOntology4.1#> .
@prefix twin: <https://example.org/scen/twin#> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

twin:S_H1s a sh:NodeShape ; sh:targetClass crm:E36_Visual_Item ;
  sh:severity sh:Violation ;
  sh:message "Drawn element has no attribution that assigns a tier (a crm:E55_Type): the picture shows something the record does not vouch for." ;
  sh:sparql [ sh:select """
    PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
    SELECT $this WHERE {
      $this crm:P138_represents ?thing .
      FILTER NOT EXISTS { ?a crm:P140_assigned_attribute_to ?thing ; crm:P141_assigned ?tier . ?tier a crm:E55_Type . }
    }""" ] .

twin:S_H3 a sh:NodeShape ; sh:targetClass crm:E36_Visual_Item ;
  sh:severity sh:Violation ;
  sh:message "The record names a visual item that is not a node of this scene (no such DEF)." ;
  sh:sparql [ sh:select """
    PREFIX x3do: <https://www.web3d.org/specifications/X3dOntology4.1#>
    SELECT $this WHERE { FILTER NOT EXISTS { $this x3do:DEF ?def } }""" ] .

twin:S_H4 a sh:NodeShape ; sh:targetClass x3do:Shape ;
  sh:severity sh:Violation ;
  sh:message "A Shape is drawn under no node the record vouches for: an element with no record at all." ;
  sh:sparql [ sh:select """
    PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
    PREFIX x3do: <https://www.web3d.org/specifications/X3dOntology4.1#>
    SELECT $this WHERE {
      FILTER NOT EXISTS { $this x3do:hasParent+ ?node . ?node crm:P138_represents ?thing . }
    }""" ] .

twin:S_H5 a sh:NodeShape ; sh:targetClass crm:E16_Measurement ;
  sh:severity sh:Violation ;
  sh:message "A measurement compared with the scene is not in metres (the scene's unit); convert it before comparing." ;
  sh:sparql [ sh:select """
    PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
    PREFIX twin: <https://example.org/scen/twin#>
    PREFIX unit: <http://qudt.org/vocab/unit/>
    SELECT $this ?value WHERE {
      $this crm:P39_measured ?thing ; crm:P40_observed_dimension ?d .
      ?d crm:P2_has_type ?axis . ?axis twin:axis ?ax .
      ?thing crm:P138i_has_representation ?o .
      OPTIONAL { ?d crm:P91_has_unit ?value }
      FILTER(!BOUND(?value) || ?value != unit:M)
    }""" ] .

twin:S_H6 a sh:NodeShape ; sh:targetClass crm:E16_Measurement ;
  sh:severity sh:Violation ;
  sh:message "The measurement cannot be checked against the scene: its representation needs exactly one Box below it and no other geometry, with no rotation and no scale between or above (other than the representation's own scale)." ;
  sh:sparql [ sh:select """
    PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
    PREFIX x3do: <https://www.web3d.org/specifications/X3dOntology4.1#>
    PREFIX twin: <https://example.org/scen/twin#>
    SELECT DISTINCT $this WHERE {
      $this crm:P39_measured ?thing ; crm:P40_observed_dimension ?d .
      ?d crm:P2_has_type ?axis . ?axis twin:axis ?ax .
      ?thing crm:P138i_has_representation ?o .
      FILTER NOT EXISTS { ?shape x3do:hasParent+ ?o ; x3do:hasGeometry ?g . ?g a x3do:Box . }
    }""" ] ;
  sh:sparql [ sh:select """
    PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
    PREFIX x3do: <https://www.web3d.org/specifications/X3dOntology4.1#>
    PREFIX twin: <https://example.org/scen/twin#>
    SELECT DISTINCT $this WHERE {
      $this crm:P39_measured ?thing ; crm:P40_observed_dimension ?d .
      ?d crm:P2_has_type ?axis . ?axis twin:axis ?ax .
      ?thing crm:P138i_has_representation ?o .
      ?shape x3do:hasParent+ ?o ; x3do:hasGeometry ?g . FILTER NOT EXISTS { ?g a x3do:Box }
    }""" ] ;
  sh:sparql [ sh:select """
    PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
    PREFIX x3do: <https://www.web3d.org/specifications/X3dOntology4.1#>
    PREFIX twin: <https://example.org/scen/twin#>
    SELECT DISTINCT $this WHERE {
      $this crm:P39_measured ?thing ; crm:P40_observed_dimension ?d .
      ?d crm:P2_has_type ?axis . ?axis twin:axis ?ax .
      ?thing crm:P138i_has_representation ?o .
      ?s1 x3do:hasParent+ ?o ; x3do:hasGeometry ?b1 . ?s2 x3do:hasParent+ ?o ; x3do:hasGeometry ?b2 . FILTER(?b1 != ?b2)
    }""" ] ;
  sh:sparql [ sh:select """
    PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
    PREFIX x3do: <https://www.web3d.org/specifications/X3dOntology4.1#>
    PREFIX twin: <https://example.org/scen/twin#>
    SELECT DISTINCT $this WHERE {
      $this crm:P39_measured ?thing ; crm:P40_observed_dimension ?d .
      ?d crm:P2_has_type ?axis . ?axis twin:axis ?ax .
      ?thing crm:P138i_has_representation ?o .
      { ?o x3do:rotation ?r }
      UNION { ?o x3do:hasParent+ ?up . { ?up x3do:rotation ?r2 } UNION { ?up x3do:scale ?k2 } }
      UNION { ?shape x3do:hasGeometry ?g ; x3do:hasParent+ ?mid . ?mid x3do:hasParent+ ?o . { ?mid x3do:rotation ?r3 } UNION { ?mid x3do:scale ?k3 } }
    }""" ] .

twin:S_H2s a sh:NodeShape ; sh:targetClass crm:E16_Measurement ;
  sh:severity sh:Violation ;
  sh:message "The drawn size (Box size times the representation's scale) differs from the documented measurement by more than 5 %." ;
  sh:sparql [ sh:select """
    PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
    PREFIX x3do: <https://www.web3d.org/specifications/X3dOntology4.1#>
    PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
    PREFIX twin: <https://example.org/scen/twin#>
    SELECT $this ?value WHERE {
      $this crm:P39_measured ?thing ; crm:P40_observed_dimension ?d .
      ?d crm:P2_has_type ?axis ; crm:P90_has_value ?rec . ?axis twin:axis ?ax .
      ?thing crm:P138i_has_representation ?o .
      ?shape x3do:hasParent+ ?o ; x3do:hasGeometry ?box . ?box a x3do:Box .
      OPTIONAL { ?box x3do:size ?L . ?L rdf:first ?bx ; rdf:rest/rdf:first ?by }
      OPTIONAL { ?o x3do:scale ?S . ?S rdf:first ?kx ; rdf:rest/rdf:first ?ky }
      BIND(COALESCE(?bx, 2) * COALESCE(?kx, 1) AS ?sx)
      BIND(COALESCE(?by, 2) * COALESCE(?ky, 1) AS ?sy)
      BIND(IF(?ax = 0, ?sx, ?sy) AS ?value)
      FILTER(ABS(?value - ?rec) > 0.05 * ?rec)
    }""" ] .
