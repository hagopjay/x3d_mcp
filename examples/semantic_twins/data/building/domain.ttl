b:HQ a brick:Building ; rdfs:label "Head office" ; brick:hasPart b:Floor3 .
b:Floor3 a brick:Floor ; rdfs:label "Floor 3" .
b:AHU1 a brick:AHU ; rdfs:label "Air handler 1" ; twin:depictedBy sc:AHU1 ; brick:feeds b:VAV301, b:VAV302, b:VAV303 .
