b:VAV301 a brick:VAV ; rdfs:label "VAV box 301" ; twin:depictedBy sc:VAV301 ; brick:feeds b:Zone301 ; brick:hasPoint b:SP301 .
b:SP301 a brick:Zone_Air_Temperature_Setpoint ; brick:value 21.0 ; brick:hasUnit unit:DEG_C .
b:OS301 a brick:Occupancy_Sensor ; brick:hasLocation b:Room301 ; twin:depictedBy sc:OccSensor301 ; brick:value 1 .
b:TS301 a brick:Zone_Air_Temperature_Sensor ; brick:hasLocation b:Room301 ; twin:depictedBy sc:TempSensor301 ; brick:value 21.4 ; brick:hasUnit unit:DEG_C .
